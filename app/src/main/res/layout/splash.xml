<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/splash_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#FCFDFE">

	<!-- Central Brand Container -->
	<LinearLayout
		android:id="@+id/container_brand"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:clipChildren="false"
		android:layout_centerInParent="true">

		<ImageView
			android:id="@+id/img_logo"
			android:layout_width="65dp"
			android:layout_height="65dp"
			android:src="@drawable/ic_splash"
			android:scaleType="fitCenter"
			android:elevation="4dp"/>

		<LinearLayout
			android:id="@+id/container_text"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_marginStart="16dp">

			<TextView
				android:id="@+id/text_title_top"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Limbu"
				android:textSize="26sp"
				android:textStyle="bold"
				android:textColor="#1F2328"
				android:includeFontPadding="false" />

			<TextView
				android:id="@+id/text_title_bottom"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Dictionary &amp; Keyboard"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="#656D76"
				android:layout_marginTop="-2dp"
				android:includeFontPadding="false" />
		</LinearLayout>
	</LinearLayout>

	<!-- Footer layout -->
	<LinearLayout
		android:id="@+id/linear2"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="24dp"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_alignParentBottom="true"
		android:layout_centerHorizontal="true">

		<TextView
			android:id="@+id/text_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Version 1.0"
			android:textSize="12sp"
			android:textColor="#8C929B" />

		<TextView
			android:id="@+id/text_developer"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:text="by Kiso Labs"
			android:textSize="13sp"
			android:textStyle="bold"
			android:textColor="#1F2328" />
	</LinearLayout>

</RelativeLayout>
