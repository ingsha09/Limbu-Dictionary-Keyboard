<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical">

    <!-- Card Container -->
    <LinearLayout
        android:id="@+id/card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/bg_word_card"
        android:orientation="vertical"
        android:descendantFocusability="afterDescendants">

        <!-- Top Header Row -->
        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_limbu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ᤛᤡᤖᤡᤈᤰᤂ"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1F2328"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <TextView
                android:id="@+id/text_roman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sirijangha"
                android:textSize="14sp"
                android:textColor="#656D76"
                android:background="@drawable/bg_roman_pill"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textIsSelectable="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="#1F2328"
                android:scaleType="fitCenter"
                android:layout_marginStart="8dp"
                android:contentDescription="Share"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_bookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_star_outline"
                app:tint="#1F2328"
                android:scaleType="fitCenter"
                android:layout_marginStart="6dp"
                android:contentDescription="Bookmark"
                android:focusable="true" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/item_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E1E4E8" />

        <!-- Nepali Meaning -->
        <TextView
            android:id="@+id/text_meaning_nepali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="सिरिजङ्घा लिपि"
            android:textSize="15sp"
            android:textColor="#1F2328"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- English Meaning -->
        <TextView
            android:id="@+id/text_meaning_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A traditional Limbu script and writing system"
            android:textSize="14sp"
            android:textColor="#656D76"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>
</LinearLayout>
